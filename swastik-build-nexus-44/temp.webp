    <script>



        var getUrlParameter = function getUrlParameter(sParam) {
            var sPageURL = window.location.search.substring(1),
                sURLVariables = sPageURL.split('&'),
                sParameterName,
                i;

            for (i = 0; i < sURLVariables.length; i++) {
                sParameterName = sURLVariables[i].split('=');

                if (sParameterName[0] === sParam) {
                    return sParameterName[1] === undefined ? true : decodeURIComponent(sParameterName[1]);
                }
            }
            return false;
        }



        if (getUrlParameter('utm_campaign')) { jQuery('.utm_campaign').val(getUrlParameter('utm_campaign')) }
        if (getUrlParameter('utm_source')) { jQuery('.utm_source').val(getUrlParameter('utm_source')) }
        if (getUrlParameter('utm_medium')) { jQuery('.utm_medium').val(getUrlParameter('utm_medium')) }
        if (getUrlParameter('utm_term')) { jQuery('.utm_term').val(getUrlParameter('utm_term')) }
        if (getUrlParameter('utm_content')) { jQuery('.utm_content').val(getUrlParameter('utm_content')) }


        // const utm_content = getUrlParameter('utm_content');






        jQuery.validator.addMethod("name_regex", function (value, element) {
            return this.optional(element) || /^[a-zA-Z0_ ]*$/i.test(value);
        }, "Firstname with only a-z A-Z.");
        jQuery.validator.addMethod("lastname_regex", function (value, element) {
            return this.optional(element) || /^[a-zA-Z0_ ]*$/i.test(value);
        }, "Lastname with only a-z A-Z.");
        jQuery.validator.addMethod("mobile_regex", function (value, element) {
            return this.optional(element) || /^[0-9\.\-_]{10,30}$/i.test(value);
        }, "Mobile Number with only 0-9. Minlength: 10");


        function leadAPI(form) {

            let data = {};

            data.first_name = $(form).find('input[name=first_name]').val();
            data.last_name = $(form).find('input[name=last_name]').val();
            data.phone = $(form).find('input[name=phone]').val();
            data.company = $(form).find('input[name=company]').val();
            data.leadSource = $(form).find('input[name=00NC5000000WkkK]').val();
            data.email = $(form).find('input[name=email]').val();
            data.project = $(form).find('select[name=00NC5000000WkkM]').val();
            data.campaign = $(form).find('input[name=Campaign__c]').val();
            data.utm_campaign = $(form).find('input[name=00NC5000000WkkO]').val();
            data.utm_medium = $(form).find('input[name=00NC5000000WkkP]').val();
            data.utm_term = $(form).find('input[name=00NT1000001h7KE]').val();
            data.utm_content = $(form).find('input[name=00NT1000001h7KD]').val();
            data.utm_source = $(form).find('input[name=00NC5000000WkkR]').val();
            data.leadSubSource = $(form).find('input[name=00NC5000000WkkS]').val();
            data.countryCode = $(form).find('select[name=00NC5000000WkkI]').val();
            data.leadStage = $(form).find('input[name=00NC5000000WkkL]').val();
            data.landingPageName = 'Luma';

            console.log('Submitting data to leadAPI:', data);
            $.ajax({
                url: 'https://api.dynamixgroup.co.in/api/v1/landingpage-leads',
                type: 'POST',
                data: data,
                timeout: 30000, // 30 second timeout
                success: function (response) {
                    console.log('leadAPI Success response:', response);
                    // Submit form to Salesforce as well
                    form.submit();
                },
                error: function (xhr, status, error) {
                    console.error('leadAPI Error:', error);
                    console.error('Status:', status);
                    console.error('Response:', xhr.responseText);

                    // Still submit to Salesforce even if API fails
                    form.submit();
                }
            });
        }

