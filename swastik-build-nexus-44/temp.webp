        [type="checkbox"]:checked,
        [type="checkbox"]:not(:checked) {
            position: absolute;
            left: -9999px;
        }

        [type="checkbox"]:checked+label.box-field,
        [type="checkbox"]:checked+label+label.box-field,
        [type="checkbox"]:not(:checked)+label.box-field,
        [type="checkbox"]:not(:checked)+label+label.box-field {
            position: relative;
            padding-left: 28px;
            cursor: pointer;
            line-height: 20px;
            display: inline-block;
            font-size: 14px;
            color: #ffffff;
            font-weight: 600;
            margin-bottom: 10px;
        }

        [type="checkbox"]:checked+label.box-field:before,
        [type="checkbox"]:checked+label+label.box-field:before,
        [type="checkbox"]:not(:checked)+label.box-field:before,
        [type="checkbox"]:not(:checked)+label+label.box-field:before {
            content: "";
            position: absolute;
            left: 0;
            top: 2px;
            width: 19px;
            height: 19px;
            border: 1px solid #fff;
            background: #fff;
        }

        [type="checkbox"]:checked+label.box-field:after,
        [type="checkbox"]:checked+label+label.box-field:after,
        [type="checkbox"]:not(:checked)+label.box-field:after,
        [type="checkbox"]:not(:checked)+label+label.box-field:after {
            content: '';
            width: 12px;
            height: 12px;
            background: #005F9E;
            position: absolute;
            top: 6px;
            left: 4px;
            -webkit-transition: all 0.2s ease;
            transition: all 0.2s ease;
        }

        [type="checkbox"]:not(:checked)+label.box-field:after,
        [type="checkbox"]:not(:checked)+label+label.box-field:after {
            opacity: 0;
            -webkit-transform: scale(0);
            transform: scale(0);
        }

        [type="checkbox"]:checked+label.box-field:after,
        [type="checkbox"]:checked+label+label.box-field:after {
            opacity: 1;
            -webkit-transform: scale(1);
            transform: scale(1);
        }

        .agree_chk_errortnc,
        .agree_chk_errortnctwo,
        .agree_chk_errortncthree,
        .agree_chk_errortncthree,
        .agree_chk_errortncfour,
        .agree_chk_errortncfive,
        .agree_chk_errortncsix,
        .agree_chk_errortncseven {
            display: none;
        }

        .agree_chk_errortnc,
        .agree_chk_errortnctwo,
        .agree_chk_errortncthree,
        .agree_chk_errortncthree,
        .agree_chk_errortncfour,
        .agree_chk_errortncfive,
        .agree_chk_errortncsix,
        .agree_chk_errortncseven {
            color: #ff0000;
            position: absolute;
            left: 15px;
            top: -15px;
            width: 100%;
            font-size: 12px;
            font-weight: 700;
        }

        .topform [type="checkbox"]:checked+label.box-field,
        .topform [type="checkbox"]:checked+label+label.box-field,
        .topform [type="checkbox"]:not(:checked)+label.box-field,
        .topform [type="checkbox"]:not(:checked)+label+label.box-field {
