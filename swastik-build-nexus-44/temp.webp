    <script>
        // Initialize the dataLayer if it doesn't already exist
        window.dataLayer = window.dataLayer || [];

        // Define the IDs of all forms to track
        const formIDs = ["price-mobilepopup", "register-form", "price-popup", "topregister-form", "brochure-form"]; // Add all your form IDs here

        // Loop through each form ID to attach event listeners
        formIDs.forEach((formID) => {
            const form = document.getElementById(formID); // Get the form by ID
            if (form && form.tagName === "FORM") { // Ensure it's a form element
                // Attach the submit event listener
                form.addEventListener("submit", function (event) {
                    // Prevent default submission for validation
                    event.preventDefault();

                    // Trigger jQuery validation on the form
                    const isValid = $(form).valid(); // Assumes jQuery Validation plugin is initialized
                    if (!isValid) {
                        console.error("Form validation failed.");
                        return; // Stop submission if validation fails
                    }

                    // Collect specific field values
                    const firstName = form.querySelector('[name="first_name"]')?.value || "";
                    const email = form.querySelector('[name="email"]')?.value || "";
                    const phone = form.querySelector('[name="phone"]')?.value || "";
                    const priceBudget = form.querySelector('[name="pricebudget"]')?.value || "";

                    // Push the data to the dataLayer
                    window.dataLayer.push({
                        event: "formSubmit",
                        formId: formID,
                        formData: {
                            first_name: firstName,
                            email: email,
                            phone: phone,
                            pricebudget: priceBudget,
                        },
                    });

                    console.log(`Data pushed to dataLayer for form ${formID}:`, {
                        first_name: firstName,
                        email: email,
                        phone: phone,
                        pricebudget: priceBudget,
                    });

                    // Explicitly submit the form after validation and dataLayer push
                    HTMLFormElement.prototype.submit.call(form); // Use native submit method
                });
            } else {
                console.error(`Form with ID ${formID} not found or not a valid form element.`);
            }
        });

    </script>



