    <script type="text/javascript">
        let generatedOtp = null; // Global variable to store the generated OTP

        function isValidPhoneNumber(phoneNumber) {
            var phonePattern = /^[0-9]{10}$/;
            return phonePattern.test(phoneNumber);
        }

        function validatePhoneNumber() {
            var phone = document.getElementById('phone').value;
            var otpButton = document.getElementById('sentOtpBtn');
            if (isValidPhoneNumber(phone)) {
                otpButton.disabled = false;
            } else {
                otpButton.disabled = true;
            }
        }

        function sendOtp(toMobile) {
            // Generate OTP and store in global variable
            generatedOtp = Math.floor(100000 + Math.random() * 900000);

            document.getElementById('verifyrow').style.display = 'block';
            // console.log(generatedOtp);
            const verifyOtpButton = document.getElementById('verifyrow');
            verifyOtpButton && verifyOtpButton.classList.remove("none-btn")
            jQuery.ajax({
                url: 'https://getwaysms.com/api/v2/SendSMS?SenderId=GETNES&DataCoding=0&Message=Your Mobile number verification OTP is ' + generatedOtp + ' Regards, Test Wellness&MobileNumbers=' + toMobile + ' &ApiKey=Jexo0EAJhhG3VeoWqJdnQ/W+Jrs2N/wBcXsxQNKKU8E=&ClientId=5c7ef8c1-35ae-49eb-b52a-a1833be0a534',
                method: 'GET',
                dataType: 'jsonp',
                success: function (response) {
                    console.log('OTP sent successfully:', response);
                },
                error: function (xhr, status, error) {
                    console.error('Error sending OTP:', status, error);
                }
            });
        }

        // OTP verification function
        function verifyOtp() {
            const userInput = document.getElementById("otp").value;
            if (userInput == generatedOtp) {
                alert("OTP Verified Successfully!");

                const submitButton = document.getElementById("submit_btnverify");
                const verifyOtpButton = document.getElementById("verifyrow");
                submitButton && submitButton?.classList.remove("none-btn");
                verifyOtpButton && verifyOtpButton.classList.add("none-btn");

                // Call leadAPI for the form
                const form = document.querySelector('form');
                if (form) {
                    leadAPI(form);
                }
            } else {
                alert("Invalid OTP. Please try again.");
            }
        }

        // Event listeners
        document.getElementById('phone').addEventListener('input', validatePhoneNumber);
        document.getElementById('verifyOtpBtn').addEventListener('click', verifyOtp);

        // Initial state
        // document.getElementById('verifyOtpBtn').disabled = true;
        document.getElementById('verifyrow').style.display = 'none';
        document.getElementById("sentOtpBtn").disabled = true;
    </script>




    <script type="text/javascript">
        (function () {
            const otpForms = [
                'topregister-form',
                'register-form',
                'main-popup',
                'price-popup',
                'brochure-form',
                'price-mobilepopup',
                '360-popup'
            ];

            function generateOtp() {
                return Math.floor(100000 + Math.random() * 900000);
            }

            function isValidPhoneNumber(phoneNumber) {
                return /^[0-9]{10}$/.test(phoneNumber);
            }

            otpForms.forEach(function (formId) {
                const form = document.getElementById(formId);
                if (!form) return;

                const phoneInput = form.querySelector('input[name="phone"]');
                let sendOtpBtn = form.querySelector('.send-otp-btn');

                if (!sendOtpBtn) {
                    sendOtpBtn = document.createElement('button');
                    sendOtpBtn.type = 'button';
                    sendOtpBtn.className = 'am-button af-secondary send-otp-btn';
                    sendOtpBtn.textContent = 'Send OTP';
                    phoneInput.parentNode.appendChild(sendOtpBtn);
                }

                let otpRow = form.querySelector('.otp-row');
                if (!otpRow) {
                    otpRow = document.createElement('div');
                    otpRow.className = 'otp-row none-btn';
                    otpRow.style.display = 'none';
                    otpRow.innerHTML = `
                    <div class="col-md-12 col-12 pd0">
                        <div class="col-md-12 col-xs-12 pd0 otp-container">
                            <input class="otp-input" maxlength="6" size="20" type="text" placeholder="Enter OTP" />
                        </div>
                        <div class="col-md-12 col-xs-12 pd0 verify-container">
                            <button type="button" class="verify-otp-btn">Verify OTP</button>
                        </div>
                    </div>
                `;
                    sendOtpBtn.parentNode.appendChild(otpRow);
                }

                form._generatedOtp = null;
                sendOtpBtn.disabled = true;

                if (phoneInput) {
                    phoneInput.addEventListener('input', function () {
                        sendOtpBtn.disabled = !isValidPhoneNumber(phoneInput.value);
                    });
                }

                sendOtpBtn.addEventListener('click', function () {
                    if (!isValidPhoneNumber(phoneInput.value)) return;
                    form._generatedOtp = generateOtp();
                    otpRow.style.display = 'block';
                    otpRow.classList.remove('none-btn');

                    jQuery.ajax({
                        url: 'https://getwaysms.com/api/v2/SendSMS?SenderId=GETNES&DataCoding=0&Message=Your Mobile number verification OTP is ' + form._generatedOtp + ' Regards, Test Wellness&MobileNumbers=' + phoneInput.value + '&ApiKey=Jexo0EAJhhG3VeoWqJdnQ/W+Jrs2N/wBcXsxQNKKU8E=&ClientId=5c7ef8c1-35ae-49eb-b52a-a1833be0a534',
                        method: 'GET',
                        dataType: 'jsonp',
                        success: function (response) {
                            console.log('OTP sent successfully:', response);
                        },
                        error: function (xhr, status, error) {
                            console.error('Error sending OTP:', status, error);
                        }
                    });
                });

                const otpInput = otpRow.querySelector('.otp-input');
                const verifyOtpBtn = otpRow.querySelector('.verify-otp-btn');

                verifyOtpBtn.addEventListener('click', function () {
                    if (otpInput.value == form._generatedOtp) {
                        alert('OTP Verified Successfully!');
                        otpRow.classList.add('none-btn');
                        otpRow.style.display = 'none';

                        // Call leadAPI for all forms
                        leadAPI(form);
                    } else {
                        alert('Invalid OTP. Please try again.');
                    }
                });
            });
        })();
    </script>

</body>

</html>