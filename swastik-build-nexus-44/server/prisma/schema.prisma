generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      String   @default("admin")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_users")
}

model HeroBanner {
  id              Int      @id @default(autoincrement())
  heading         String   @db.VarChar(255)
  subtext         String   @db.Text
  backgroundImage String?  @db.VarChar(500)
  image2560       String?  @db.VarChar(500)
  image1920       String?  @db.VarChar(500)
  image1536       String?  @db.VarChar(500)
  imageMobile     String?  @db.VarChar(500)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("hero_banners")
}

model Section {
  id         Int      @id @default(autoincrement())
  sectionKey String   @unique @db.VarChar(100)
  title      String   @db.VarChar(255)
  content    String   @db.LongText
  image      String?  @db.VarChar(500)
  extraData  String?  @db.LongText
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("sections")
}

model ValueVisionMission {
  id        Int      @id @default(autoincrement())
  type      String   @db.VarChar(20)
  title     String   @db.VarChar(255)
  content   String   @db.Text
  image     String?  @db.VarChar(500)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("values_vision_mission")
}

model FeatureCard {
  id          Int      @id @default(autoincrement())
  page        String   @db.VarChar(50)
  title       String   @db.VarChar(255)
  description String   @db.Text
  icon        String?  @db.VarChar(100)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("feature_cards")
}

model Project {
  id              Int                    @id @default(autoincrement())
  slug            String                 @unique @db.VarChar(255)
  name            String                 @db.VarChar(255)
  subtitle        String?                @db.VarChar(255)
  location        String                 @db.VarChar(255)
  price           String?                @db.VarChar(100)
  image           String?                @db.VarChar(500)
  description     String                 @db.Text
  fullDescription String?                @db.LongText
  configuration   String?                @db.VarChar(100)
  status          String                 @default("ongoing") @db.VarChar(20)
  tag             String?                @db.VarChar(100)
  maharera        String?                @db.VarChar(100)
  sortOrder       Int                    @default(0)
  isActive        Boolean                @default(true)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  googleMapsUrl   String?                @db.Text
  disclaimer      String?                @db.Text
  financeBy       String?                @db.VarChar(255)
  mahareraQr      String?                @db.VarChar(500)
  mahareraUrl               String?                @db.VarChar(500)
  floorPlanImage            String?                @db.VarChar(500)
  connectivitiesDescription String?                @db.Text
  aboutDeveloperText        String?                @db.Text
  aboutDeveloperImage       String?                @db.VarChar(500)
  amenities                 ProjectAmenity[]
  configurations            ProjectConfiguration[]
  connectivities            ProjectConnectivity[]
  gallery                   ProjectGalleryImage[]

  @@map("projects")
}

model ProjectConfiguration {
  id        Int     @id @default(autoincrement())
  projectId Int
  type      String  @db.VarChar(50)
  area      String  @db.VarChar(100)
  price     String  @db.VarChar(100)
  sortOrder Int     @default(0)
  image     String? @db.VarChar(500)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId], map: "project_configurations_projectId_fkey")
  @@map("project_configurations")
}

model ProjectAmenity {
  id        Int     @id @default(autoincrement())
  projectId Int
  name      String  @db.VarChar(255)
  category  String  @default("podium") @db.VarChar(50)
  sortOrder Int     @default(0)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId], map: "project_amenities_projectId_fkey")
  @@map("project_amenities")
}

model ProjectConnectivity {
  id        Int     @id @default(autoincrement())
  projectId Int
  text      String  @db.VarChar(255)
  sortOrder Int     @default(0)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId], map: "project_connectivities_projectId_fkey")
  @@map("project_connectivities")
}

model ProjectGalleryImage {
  id        Int     @id @default(autoincrement())
  projectId Int
  imageUrl  String  @db.VarChar(500)
  caption   String? @db.VarChar(255)
  sortOrder Int     @default(0)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId], map: "project_gallery_images_projectId_fkey")
  @@map("project_gallery_images")
}

model Blog {
  id          Int       @id @default(autoincrement())
  slug        String    @unique @db.VarChar(255)
  title       String    @db.VarChar(255)
  excerpt     String    @db.Text
  content     String    @db.LongText
  image       String?   @db.VarChar(500)
  author      String    @default("Admin") @db.VarChar(100)
  status      String    @default("draft") @db.VarChar(20)
  views       Int       @default(0)
  publishDate DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("blogs")
}

model FAQ {
  id        Int      @id @default(autoincrement())
  question  String   @db.Text
  answer    String   @db.LongText
  category  String?  @db.VarChar(100)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faqs")
}

model Statistic {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(100)
  label     String   @db.VarChar(255)
  value     String   @db.VarChar(50)
  suffix    String?  @db.VarChar(50)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("statistics")
}

model SocialMediaLink {
  id        Int      @id @default(autoincrement())
  platform  String   @db.VarChar(50)
  url       String   @db.VarChar(500)
  icon      String?  @db.VarChar(100)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("social_media_links")
}

model SocialMediaPost {
  id        Int      @id @default(autoincrement())
  image     String   @db.VarChar(500)
  alt       String?  @db.VarChar(255)
  link      String?  @db.VarChar(500)
  platform  String   @default("instagram") @db.VarChar(50)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("social_media_posts")
}

model Location {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(255)
  address   String?  @db.Text
  mapUrl    String?  @db.VarChar(500)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("locations")
}

model Media {
  id           Int      @id @default(autoincrement())
  filename     String   @db.VarChar(255)
  originalName String   @db.VarChar(255)
  mimeType     String   @db.VarChar(100)
  size         Int
  url          String   @db.VarChar(500)
  altText      String?  @db.VarChar(255)
  uploadedBy   String?  @db.VarChar(100)
  createdAt    DateTime @default(now())

  @@map("media")
}

model Inquiry {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(255)
  email     String?  @db.VarChar(255)
  phone     String   @db.VarChar(20)
  message   String?  @db.Text
  projectId Int?
  source    String?  @db.VarChar(50)
  status    String   @default("new") @db.VarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("inquiries")
}

model LoyaltySubmission {
  id             Int      @id @default(autoincrement())
  firstName      String   @db.VarChar(100)
  lastName       String   @db.VarChar(100)
  contactNumber  String   @db.VarChar(20)
  email          String   @db.VarChar(255)
  refereeName    String   @db.VarChar(255)
  refereeContact String   @db.VarChar(20)
  preferredUnit  String   @db.VarChar(50)
  status         String   @default("pending") @db.VarChar(20)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("loyalty_submissions")
}
