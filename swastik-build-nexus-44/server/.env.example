# Swastik CMS Server Environment Variables
# Copy this file to .env and fill in your values

# ─── Database ───────────────────────────────────────────
# For local development:
DATABASE_URL="mysql://root:password@localhost:3306/swastik_cms"
# For AWS RDS:
# DATABASE_URL="mysql://admin:yourpassword@your-rds-endpoint.amazonaws.com:3306/swastik_cms"

# ─── Server ─────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── JWT Authentication ─────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# ─── CORS ────────────────────────────────────────────────
# Comma separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ─── File Upload ─────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# ─── AWS S3 (for production image storage) ───────────────
# When all 4 values are set, uploads go to S3 instead of local disk.
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-s3-bucket-name
AWS_S3_UPLOAD_FOLDER=uploads
